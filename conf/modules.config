/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MCSTAGING_MACSIMA2MC' {
        ext.args = {[
            params.illumination_correction  ? "-ic" : "",
            params.hi_exposure_only         ? "-he" : "",
            params.remove_reference_marker  ? "-rr" : "",
            params.qc_metrics               ? "-qc" : "",
            params.write_table              ? "-wt" : ""
        ].join(' ').trim()}
        publishDir = [
            path: { "${params.outdir}/macsima2mc/${meta.experiment}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ASHLAR' {
        ext.args  = '--flip-y'
        publishDir = [
            path: { "${params.outdir}/ashlar/${meta.experiment}/${meta.sample}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BACKSUB' {
        ext.prefix = { "${meta.id}_backsub" }
        publishDir = [
            path: { "${params.outdir}/backsub/${meta.experiment}/${meta.sample}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CELLPOSE' {
        ext.args = {[
            "--channel_axis 0",
            params.cellpose_diameter           ? "--diameter ${params.cellpose_diameter}"                 : "",
            params.cellpose_chan               ? "--chan ${params.cellpose_chan}"                         : "",
            params.cellpose_chan2              ? "--chan2 ${params.cellpose_chan2}"                        : "",
            params.cellpose_save_flows         ? "--save_flows"                                           : "",
            params.cellpose_flow_threshold     ? "--flow_threshold ${params.cellpose_flow_threshold}"     : "",
            params.cellpose_custom_model       ? ""                                                       : params.cellpose_pretrained_model ? "--pretrained_model ${params.cellpose_pretrained_model}" : "",
        ].join(' ').trim()}
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/cellpose/${meta.experiment}/${meta.sample}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RAMI2D_REGISTER' {
        ext.args ={"-mpp-key 3"}
        publishDir = [
            path: { "${params.outdir}/rami2d/${meta.experiment}/${meta.sample}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RAMI2D_TRANSFORM' {
        publishDir = [
            path: { "${params.outdir}/rami2d/${meta.experiment}/${meta.sample}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'STAINWARPY_REGISTER' {
        memory = { 12.GB * task.attempt }
    }


}
