// Wiring only: version commands are shims created by run_stub.py.
process {
    executor = 'local'
    cpus = 1
    memory = '1.GB'
    resourceLimits = [cpus: 2, memory: '2.GB']
    maxForks = 2
}
docker.enabled = false
conda.enabled = false
params.validate_params = true
params.monochrome_logs = true
params.rami2d_mpp_fix = 0.17
params.rami2d_mpp_mov = 0.5023
