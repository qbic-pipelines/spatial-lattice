params {
    fixture = null
    outdir = 'testing/prototype-rami2d'
    rami2d_mpp_fix = 0.17
    rami2d_mpp_mov = 0.17
    rami2d_ifix = 0
    rami2d_imov = 0
    rami2d_mpp_reg = 0.17
    rami2d_mpp_key = 0.17
    rami2d_scheme = 1
    rami2d_initial_alignment = false
}
process {
    executor = 'local'
    cpus = 2
    memory = '4.GB'
    maxForks = 1
    publishDir = [path: { "${params.outdir}/${meta.id}" }, mode: 'copy']
}
docker.enabled = true
