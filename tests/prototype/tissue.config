includeConfig 'rami2d.config'
params {
    registration_backend = 'stainwarpy'
    fixed_img = 'multiplexed'
    final_sz = 'multiplexed'
    rami2d_ifix = 2
    rami2d_imov = 'h'
    rami2d_mpp_reg = 0.5
    rami2d_mpp_key = 0.5
    rami2d_initial_alignment = true
}
process {
    withName: 'STAINWARPY_EXTRACTCHANNEL' {
        ext.args = '--channel-idx 2'
    }
}
